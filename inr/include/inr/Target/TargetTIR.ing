class TIRInstID;

def STORE            : TIRInstID;
def ADD_DEST_SRC     : TIRInstID;
def ADD_DEST_SRC_SRC : TIRInstID;
def RET              : TIRInstID;

class TIROp;

def TIRReg : TIROp;
def TIRImm : TIROp;
def TIRMem : TIROp;

class TIRPatternIn<TIRInstID inst, irtype type, list<TIROp> operands> {
    TIRInstID Inst = inst;
    irtype Type = type;
    list<TIROp> Operands = operands;
}

class TIRTargetInst;

class TIRPatternOut<string asmStr> {
    string AsmStr = asmStr;
}

class TIRInstruction<TIRPatternIn in, TIRPatternOut out> {
    TIRPatternIn In = in;
    TIRPatternOut Out = out;
}