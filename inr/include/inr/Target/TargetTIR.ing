class TIRInstID;

def STORE            : TIRInstID;
def ADD_DEST_SRC     : TIRInstID;
def ADD_DEST_SRC_SRC : TIRInstID;
def SUB_DEST_SRC     : TIRInstID;
def SUB_DEST_SRC_SRC : TIRInstID;
def RET              : TIRInstID;
def NONE             : TIRInstID;

class TIROp;

def TIRReg : TIROp;
def TIRImm : TIROp;
def TIRMem : TIROp;

class TIROperand<TIROp op, string name> {
    TIROp Op = op;
    string Name = name;
}

class TIRPatternIn<TIRInstID inst, irtype type, list<TIROperand> operands> {
    TIRInstID Inst = inst;
    irtype Type = type;
    list<TIROperand> Operands = operands;
}

class TIRPatternOut<string asmStr, list<string> operands> {
    string AsmStr = asmStr;
    list<string> Operands = operands;
}

class TIRInstruction<TIRPatternIn in, TIRPatternOut out> {
    TIRPatternIn In = in;
    TIRPatternOut Out = out;
}