include "inr/Target/Target.ing";

// Reg to reg

def SUB8rr : TIRInstruction<
    TIRPatternIn<SUB_DEST_SRC, i8, [TIROperand<TIRReg, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"subb", ["src", "dest"]>
>;

def SUB16rr : TIRInstruction<
    TIRPatternIn<SUB_DEST_SRC, i16, [TIROperand<TIRReg, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"subw", ["src", "dest"]>
>;

def SUB32rr : TIRInstruction<
    TIRPatternIn<SUB_DEST_SRC, i32, [TIROperand<TIRReg, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"subl", ["src", "dest"]>
>;

def SUB64rr : TIRInstruction<
    TIRPatternIn<SUB_DEST_SRC, i64, [TIROperand<TIRReg, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"subq", ["src", "dest"]>
>;

// Imm to reg

def SUB8ri : TIRInstruction<
    TIRPatternIn<SUB_DEST_SRC, i8, [TIROperand<TIRReg, "dest">, TIROperand<TIRImm, "src">]>,
    TIRPatternOut<"subb", ["src", "dest"]>
>;

def SUB16ri : TIRInstruction<
    TIRPatternIn<SUB_DEST_SRC, i16, [TIROperand<TIRReg, "dest">, TIROperand<TIRImm, "src">]>,
    TIRPatternOut<"subw", ["src", "dest"]>
>;

def SUB32ri : TIRInstruction<
    TIRPatternIn<SUB_DEST_SRC, i32, [TIROperand<TIRReg, "dest">, TIROperand<TIRImm, "src">]>,
    TIRPatternOut<"subl", ["src", "dest"]>
>;

def SUB64ri : TIRInstruction<
    TIRPatternIn<SUB_DEST_SRC, i64, [TIROperand<TIRReg, "dest">, TIROperand<TIRImm, "src">]>,
    TIRPatternOut<"subq", ["src", "dest"]>
>;
