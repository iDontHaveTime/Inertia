include "inr/Target/Target.ing";

def MOV32rr : TIRInstruction<
    TIRPatternIn<STORE, i32, [TIROperand<TIRReg, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"movl", ["src", "dest"]>
>;

def MOV32ri : TIRInstruction<
    TIRPatternIn<STORE, i32, [TIROperand<TIRReg, "dest">, TIROperand<TIRImm, "src">]>,
    TIRPatternOut<"movl", ["src", "dest"]>
>;

def MOV32rm : TIRInstruction<
    TIRPatternIn<STORE, i32, [TIROperand<TIRReg, "dest">, TIROperand<TIRMem, "src">]>,
    TIRPatternOut<"movl", ["src", "dest"]>
>;

def MOV32mr : TIRInstruction<
    TIRPatternIn<STORE, i32, [TIROperand<TIRMem, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"movl", ["src", "dest"]>
>;

def RETx86 : TIRInstruction<
    TIRPatternIn<RET, void, []>,
    TIRPatternOut<"ret", []>
>;

def ADD32rr : TIRInstruction<
    TIRPatternIn<ADD_DEST_SRC, i32, [TIROperand<TIRReg, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"addl", ["src", "dest"]>
>;

def ADD32ri : TIRInstruction<
    TIRPatternIn<ADD_DEST_SRC, i32, [TIROperand<TIRReg, "dest">, TIROperand<TIRImm, "src">]>,
    TIRPatternOut<"addl", ["src", "dest"]>
>;
