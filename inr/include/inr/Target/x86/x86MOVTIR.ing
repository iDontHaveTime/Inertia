include "inr/Target/Target.ing";

// Register to register

def MOV8rr : TIRInstruction<
    TIRPatternIn<STORE, i8, [TIROperand<TIRReg, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"movb", ["src", "dest"]>
>;

def MOV16rr : TIRInstruction<
    TIRPatternIn<STORE, i16, [TIROperand<TIRReg, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"movw", ["src", "dest"]>
>;

def MOV32rr : TIRInstruction<
    TIRPatternIn<STORE, i32, [TIROperand<TIRReg, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"movl", ["src", "dest"]>
>;

def MOV64rr : TIRInstruction<
    TIRPatternIn<STORE, i64, [TIROperand<TIRReg, "dest">, TIROperand<TIRReg, "src">]>,
    TIRPatternOut<"movq", ["src", "dest"]>
>;

// Imm to register

def MOV8ri : TIRInstruction<
    TIRPatternIn<STORE, i8, [TIROperand<TIRReg, "dest">, TIROperand<TIRImm, "src">]>,
    TIRPatternOut<"movb", ["src", "dest"]>
