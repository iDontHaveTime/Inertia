def MOV32ri : TIRInstruction<
    TIRPatternIn<STORE, i32, [TIROperand<TIRReg, "dest">, TIROperand<TIRImm, "src">]>,
    TIRPatternOut<"movl", ["src", "dest"]>
>;

def MOV64ri : TIRInstruction<
    TIRPatternIn<STORE, i64, [TIROperand<TIRReg, "dest">, TIROperand<TIRImm, "src">]>,
    TIRPatternOut<"movq", ["src", "dest"]>
>;

