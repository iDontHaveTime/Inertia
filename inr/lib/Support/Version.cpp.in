#include <inr/Support/Version.h>

// clang-format off
inr::Version inr::getInertiaVersion() {
    return inr::Version(@INERTIA_VERSION_MAJOR@, @INERTIA_VERSION_MINOR@,
                        @INERTIA_VERSION_PATCH@);
}
// clang-format on
