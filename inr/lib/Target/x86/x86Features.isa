(namespace inr
    (namespace x86
        (feature long_mode false)

        (feature x87_fpu true)

        (feature sse false)
        (feature sse2 false)
        (feature sse3 false)
        (feature ssse3 false)
        (feature sse4_1 false)
        (feature sse4_2 false)

        (feature avx false)
        (feature avx2 false)
    )
)