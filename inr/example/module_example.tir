; TIRModule = main_module
; target = x86_64-linux-gnu
proc i32 @main(i32 %argc, ptr %argv) {
entry:
	%0 = reg rsp
	%1 = imm 4
	sub i64 %0, %1
	%2 = vreg 0
	%3 = reg edi
	store i32 %2, %3
	%4 = vreg 1
	store i32 %4, %2
	%5 = imm 20
	add i32 %4, %5
	%6 = mem (reg rsp)
	store i32 %6, %4
	%7 = reg eax
	store i32 %7, %4
	%8 = imm 4
	add i64 %0, %8
	ret
}
